# RoutineForge — root .env.example
#
# Copy to .env.local at repo root and fill in values.
# scripts/manage.ts (the owner-token CLI) reads from this file.
# The Next.js app reads its own copy at apps/web/.env.local — keep them in sync.
#
# See docs/ENV.md for the canonical, fully-documented list.

# --- Owner-token CLI (scripts/manage.ts) ---

# Long random secret. The CLI sends this as `Authorization: Bearer <token>` to
# /api/owner/** routes. Generate with: openssl rand -hex 32
OWNER_API_TOKEN=replace-with-long-random-hex

# Base URL the CLI hits. Defaults to http://localhost:3000 when unset.
APP_BASE_URL=http://localhost:3000

# --- Email (read by the web app, NOT the CLI — listed here for parity) ---
# These vars are consumed by apps/web (verification email send). The CLI
# itself doesn't email anything; they're documented here so a single
# .env.local at the repo root can hold every secret. See docs/ENV.md.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# EMAIL_PROVIDER=
